{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "Logs/log.txt" } }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Destructure": [
      { "Name": "ToMaximumDepth", "Args": { "maximumDestructuringDepth": 4 } },
      {
        "Name": "ToMaximumStringLength",
        "Args": { "maximumStringLength": 100 }
      },
      {
        "Name": "ToMaximumCollectionCount",
        "Args": { "maximumCollectionCount": 10 }
      }
    ],
    "Properties": {
      "Application": "TaskSync"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "MetadataAddress": "https://dev-ng4mbx4gds2o61r1.eu.auth0.com/.well-known/openid-configuration",
    "Authority": "https://dev-ng4mbx4gds2o61r1.eu.auth0.com/",
    "Audience": "https://tasksync.api.de/api",
    "ValidIssuer": "https://dev-ng4mbx4gds2o61r1.eu.auth0.com/",
    "MachineToMachineApplication": {
      "Domain": "https://dev-ng4mbx4gds2o61r1.eu.auth0.com"
    }
  }
}
